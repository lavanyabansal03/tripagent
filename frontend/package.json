{
  "name": "tripagent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TripAgent frontend — Svelte 5 + Vite + TypeScript. Owned by the Frontend & Maps Eng. role.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "oxlint",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "mapbox-gl": "^3.32.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.5",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^27.0.0",
    "oxlint": "^1.81.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  }
}
