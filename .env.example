# Copy to .env. Never commit real keys.
GOOGLE_API_KEY=
# NVIDIA Nemotron (free key at build.nvidia.com). LLM_PRIMARY: which LLM goes
# first, nvidia (default, more reliable) or gemini; the other is the backup.
NVIDIA_API_KEY=
LLM_PRIMARY=nvidia
MAPBOX_SECRET_TOKEN=
GEOAPIFY_API_KEY=
# Local: a SQLite file (default). Online: a Postgres connection string, e.g. from Neon.
DATABASE_URL=sqlite:///./tripagent.db
DEMO_MODE=true
