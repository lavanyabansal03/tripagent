# TripAgent frontend environment.
# Copy to .env.local. NEVER commit real tokens.

# Demo mode uses recorded fixtures for every external tool (FR-55). Keep true
# unless you are running the FastAPI backend locally.
VITE_DEMO_MODE=true

# Public, URL-restricted Mapbox token. Only this token reaches the browser
# (SRS Section 11). Leave blank to use the built-in schematic map fallback.
VITE_MAPBOX_PUBLIC_TOKEN=

# Dev-server proxy target for the FastAPI service (not shipped to the browser).
VITE_API_PROXY=http://localhost:8000
